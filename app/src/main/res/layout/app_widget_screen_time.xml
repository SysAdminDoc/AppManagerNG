<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_background"
    style="@style/Widget.AppTheme.AppWidget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_widget_background"
    android:padding="0dp"
    android:theme="@style/AppTheme.AppWidgetContainer">

    <include
        layout="@layout/app_widget_refresh_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/app_widget_background_padding">

        <TextView
            android:id="@+id/screen_time_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/screen_time"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/screen_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="38sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="2h 30m"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="27sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            tools:targetApi="o" />

        <!-- The bubbles are placed in dp, so a larger font doesn't move them. Each label takes its
             bubble's top and bottom and centres its text there, so it stays beside its bubble at
             any font size, and each bubble's text shrinks to fit the bubble instead of being cut. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0">

            <TextView
                android:id="@+id/app3_time"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="4dp"
                android:layout_marginTop="64dp"
                android:autoSizeMaxTextSize="@dimen/font_size_medium"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/circle_background"
                android:backgroundTint="?attr/colorTertiaryContainer"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="20m"
                android:textColor="?attr/colorOnTertiaryContainer"
                android:textSize="@dimen/font_size_medium"
                android:textStyle="bold"
                tools:ignore="HardcodedText"
                tools:targetApi="o" />

            <TextView
                android:id="@+id/app2_time"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="2dp"
                android:layout_marginTop="32dp"
                android:autoSizeMaxTextSize="@dimen/font_size_medium"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/circle_background"
                android:backgroundTint="?attr/colorSecondaryContainer"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="45m"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="@dimen/font_size_medium"
                android:textStyle="bold"
                tools:ignore="HardcodedText"
                tools:targetApi="o" />

            <TextView
                android:id="@+id/app1_time"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:autoSizeMaxTextSize="@dimen/font_size_medium"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/circle_background"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="~1h"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="@dimen/font_size_medium"
                android:textStyle="bold"
                tools:ignore="HardcodedText"
                tools:targetApi="o" />

            <TextView
                android:id="@+id/app1_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/app1_time"
                android:layout_alignBottom="@id/app1_time"
                android:layout_alignParentStart="true"
                android:layout_marginStart="52dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Signal"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/font_size_medium"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/app2_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/app2_time"
                android:layout_alignBottom="@id/app2_time"
                android:layout_alignParentStart="true"
                android:layout_marginStart="52dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="App Manager"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/font_size_medium"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/app3_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/app3_time"
                android:layout_alignBottom="@id/app3_time"
                android:layout_alignParentStart="true"
                android:layout_marginStart="52dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="K-9 Mail"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/font_size_medium"
                tools:ignore="HardcodedText" />

        </RelativeLayout>

    </LinearLayout>

</FrameLayout>
