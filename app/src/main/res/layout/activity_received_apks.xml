<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".sync.lan.ReceivedApksActivity">

    <io.github.muntashirakon.widget.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@android:id/list">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.AppTheme.V2.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/premium_app_bar_height"
            android:minHeight="@dimen/premium_app_bar_height"
            app:title="@string/received_apks_title" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_linear"
            style="@style/Widget.AppTheme.LinearProgressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_medium"
            android:text="@string/received_apks_keep_for"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/retention_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_medium"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/retention_2_hours"
                style="@style/Widget.AppTheme.Chip.MainFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/received_apks_2_hours" />

            <com.google.android.material.chip.Chip
                android:id="@+id/retention_24_hours"
                style="@style/Widget.AppTheme.Chip.MainFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/received_apks_24_hours" />

            <com.google.android.material.chip.Chip
                android:id="@+id/retention_7_days"
                style="@style/Widget.AppTheme.Chip.MainFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/op_history_retention_7d" />

        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/keep_installed"
            style="@style/Widget.AppTheme.MaterialSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_medium"
            android:layout_marginBottom="@dimen/premium_space_8"
            android:saveEnabled="false"
            android:text="@string/received_apks_keep_installed" />

    </io.github.muntashirakon.widget.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <io.github.muntashirakon.widget.RecyclerView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fitsSystemWindows="true"
            tools:listitem="@layout/item_received_apk" />

        <include
            android:id="@android:id/empty"
            layout="@layout/view_list_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
