<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/premium_space_20"
        android:paddingTop="@dimen/premium_space_12"
        android:paddingBottom="@dimen/premium_space_24">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AppTheme.V2.Card.Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="@dimen/premium_space_16">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/icon"
                    android:layout_width="@dimen/premium_icon_48"
                    android:layout_height="@dimen/premium_icon_48"
                    android:background="@drawable/main_icon_frame_background"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.AppTheme.CircleComponent"
                    tools:srcCompat="@mipmap/ic_launcher_round" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/premium_space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        tools:text="@string/app_name" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/package_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/premium_space_4"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textIsSelectable="true"
                        tools:text="package.name" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/info"
                    style="@style/Widget.AppTheme.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/premium_space_8"
                    android:contentDescription="@string/app_info"
                    app:icon="@drawable/ic_information"
                    app:iconSize="@dimen/premium_icon_24" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </com.google.android.material.card.MaterialCardView>

        <io.github.muntashirakon.widget.FlowLayout
            android:id="@+id/tag_cloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/premium_space_12"
            android:gravity="start"
            tools:listItem="@layout/item_chip" />

        <io.github.muntashirakon.widget.MaterialAlertView
            android:id="@+id/alert_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/premium_space_8"
            app:alertType="warn"
            tools:text="An example warning." />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/apk_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/premium_space_12"
            android:textAppearance="?attr/textAppearanceListItemSecondary"
            android:autoLink="web"
            android:textIsSelectable="true"
            tools:text="@tools:sample/lorem/random" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/premium_space_16"
                android:textAppearance="?attr/textAppearanceListItemSecondary"
                android:textStyle="bold"
                android:text="@string/title_alternatives_to_bloatware" />

            <io.github.muntashirakon.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</ScrollView>
