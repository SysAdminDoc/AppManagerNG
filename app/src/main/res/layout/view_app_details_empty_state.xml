<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/premium_space_32"
    android:paddingVertical="@dimen/premium_space_24"
    tools:visibility="visible">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/empty_state_icon"
        android:layout_width="@dimen/premium_icon_48"
        android:layout_height="@dimen/premium_icon_48"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="@dimen/premium_space_4"
        android:src="@drawable/ic_information_circle"
        app:tint="?attr/colorPrimary" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/empty_state_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/premium_space_12"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="@string/no_activities" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/empty_state_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/premium_space_8"
        android:gravity="center"
        android:maxWidth="@dimen/main_empty_summary_max_width"
        android:text="@string/app_details_empty_message_no_items"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/empty_state_action"
        style="@style/Widget.AppTheme.Button.FilledTonalButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/premium_button_min_height"
        android:layout_marginTop="@dimen/premium_space_20"
        android:minWidth="144dp"
        android:text="@string/refresh"
        app:icon="@drawable/ic_refresh"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/premium_space_8" />

</androidx.appcompat.widget.LinearLayoutCompat>
