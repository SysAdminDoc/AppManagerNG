<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/premium_space_32"
    android:paddingVertical="@dimen/premium_space_24">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/empty_state_icon"
        android:layout_width="@dimen/premium_icon_48"
        android:layout_height="@dimen/premium_icon_48"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="@dimen/premium_space_4"
        android:src="@drawable/ic_settings"
        app:tint="?attr/colorPrimary" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/empty_state_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/premium_space_12"
        android:gravity="center"
        android:text="@string/settings_search_empty_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/empty_state_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/premium_space_8"
        android:gravity="center"
        android:maxWidth="@dimen/main_empty_summary_max_width"
        android:text="@string/settings_search_empty_message"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

</androidx.appcompat.widget.LinearLayoutCompat>
