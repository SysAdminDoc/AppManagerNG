<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AppTheme.V2.Card.ListRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:minHeight="@dimen/main_list_min_height"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/premium_main_list_padding_horizontal"
            android:paddingVertical="@dimen/premium_main_list_padding_vertical">

            <FrameLayout
                android:layout_width="@dimen/premium_main_icon_frame"
                android:layout_height="@dimen/premium_main_icon_frame"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/premium_space_12">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/icon"
                    android:layout_width="@dimen/main_list_icon_size"
                    android:layout_height="@dimen/main_list_icon_size"
                    android:layout_gravity="center"
                    android:contentDescription="@string/str_logo"
                    android:scaleType="fitCenter"
                    tools:srcCompat="@mipmap/ic_launcher_round" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/attention_badge"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="end|top"
                    android:src="@drawable/bg_attention_dot"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </FrameLayout>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="@dimen/premium_zero"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingEnd="@dimen/premium_space_32"
                        android:textAppearance="@style/TextAppearance.AppTheme.V2.TitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:ignore="RtlSymmetry"
                        tools:text="Aurora Store" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/debug_indicator"
                        android:layout_width="@dimen/premium_favorite_hit_size"
                        android:layout_height="@dimen/premium_favorite_hit_size"
                        android:layout_gravity="end|center_vertical"
                        android:contentDescription="@string/main_list_debuggable_indicator"
                        android:padding="@dimen/premium_space_4"
                        android:src="@drawable/ic_code"
                        app:tint="?attr/colorTertiary" />

                </FrameLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/packageName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.AppTheme.V2.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="com.aurora.store" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/metadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/premium_space_4"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.AppTheme.V2.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="v4.7.3 · User · SDK 35" />

                <io.github.muntashirakon.widget.FlowLayout
                    android:id="@+id/status_badge_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/premium_space_4"
                    android:gravity="start|center_vertical"
                    app:rowSpacing="@dimen/premium_space_4">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/backup_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/premium_space_8"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:maxWidth="@dimen/premium_badge_max_width"
                        android:minHeight="@dimen/premium_badge_min_height"
                        android:text="@string/backup"
                        android:textAppearance="@style/TextAppearance.AppTheme.V2.LabelSmall"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tracker_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/premium_space_8"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:maxWidth="@dimen/premium_badge_max_width"
                        android:minHeight="@dimen/premium_badge_min_height"
                        android:textAppearance="@style/TextAppearance.AppTheme.V2.LabelSmall"
                        android:visibility="gone"
                        tools:text="3 trackers"
                        tools:visibility="visible" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/perm_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/premium_space_8"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:maxWidth="@dimen/premium_badge_max_width"
                        android:minHeight="@dimen/premium_badge_min_height"
                        android:textAppearance="@style/TextAppearance.AppTheme.V2.LabelSmall"
                        android:visibility="gone"
                        tools:text="3/8 perms"
                        tools:visibility="visible" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tag_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:maxWidth="@dimen/premium_badge_max_width"
                        android:minHeight="@dimen/premium_badge_min_height"
                        android:textAppearance="@style/TextAppearance.AppTheme.V2.LabelSmall"
                        android:visibility="gone"
                        tools:text="work +2"
                        tools:visibility="visible" />

                </io.github.muntashirakon.widget.FlowLayout>

                <!-- The adapter still populates these fields for content descriptions and
                     compatibility with existing bind paths. The compact row exposes the same
                     information through metadata and inline status text instead. -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/shareid" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/version" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/isSystem" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/size" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/sha" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/issuer" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/backup_info" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/backup_info_ext" android:layout_width="wrap_content" android:layout_height="wrap_content" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/premium_stroke_hairline"
            android:layout_marginStart="@dimen/premium_main_divider_inset"
            android:background="?attr/colorOutlineVariant" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>
