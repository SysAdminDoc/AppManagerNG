    <exclude domain="file" path="profiles" />

    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
    <exclude domain="sharedpref" path="device_local_secrets.xml" />
    <exclude domain="sharedpref" path="keystore.xml" />
    <exclude domain="sharedpref" path="io.github.sysadmindoc.AppManagerNG.batch_ops_journal.xml" />
    <exclude domain="sharedpref" path="installer_state.xml" />
    <exclude domain="sharedpref" path="server_secrets.xml" />
</full-backup-content>
