<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:key="freeze_type"
        app:title="@string/pref_default_freezing_method"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        app:key="auto_freeze_on_lock"
        app:title="@string/pref_auto_freeze_on_lock"
        app:summary="@string/pref_auto_freeze_on_lock_summary"
        app:iconSpaceReserved="false" />

    <SeekBarPreference
        app:key="auto_freeze_delay_seconds"
        app:title="@string/pref_auto_freeze_delay"
        app:summary="@string/pref_auto_freeze_delay_summary"
        app:dependency="auto_freeze_on_lock"
        app:min="0"
        android:max="600"
        app:showSeekBarValue="true"
        app:updatesContinuously="false"
        app:iconSpaceReserved="false" />

    <Preference
        app:key="default_blocking_method"
        app:title="@string/pref_default_blocking_method"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        app:key="global_blocking_enabled"
        app:title="@string/pref_global_blocking_enabled"
        app:summary="@string/pref_global_blocking_enabled_msg"
        app:iconSpaceReserved="false" />

    <Preference
        app:key="component_rules_editor"
        app:title="@string/pref_component_rules_editor"
        app:summary="@string/pref_component_rules_editor_msg"
        android:fragment="io.github.muntashirakon.AppManager.settings.ComponentRulesPreferences"
        app:iconSpaceReserved="false" />

    <Preference
        app:key="import_export_rules"
        app:title="@string/pref_import_export_blocking_rules"
        app:summary="@string/pref_import_export_blocking_rules_msg"
        android:fragment="io.github.muntashirakon.AppManager.settings.ImportExportRulesPreferences"
        app:iconSpaceReserved="false" />

    <io.github.muntashirakon.preference.PrimaryButtonPreference
        app:key="remove_all_rules"
        app:title="@string/pref_remove_all_rules"
        app:icon="@drawable/ic_restore"/>

</PreferenceScreen>
