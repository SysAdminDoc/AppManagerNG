<resources>

    <!-- windowSplashScreenBackground must be a concrete color: the splash theme chain
         (Theme.SplashScreen -> DeviceDefault) never defines the Material colorSurface
         attr, so a ?attr reference silently falls back to the platform default. -->
    <style name="AppTheme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/premium_surface_0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme.V2</item>
    </style>

    <style name="AppTheme.Splash.Black" parent="AppTheme.Splash">
        <item name="windowSplashScreenBackground">@color/premium_surface_0_amoled</item>
        <item name="postSplashScreenTheme">@style/AppTheme.V2.Amoled</item>
    </style>

    <style name="AppTheme.AppWidgetContainerParent" parent="AppTheme">
        <item name="appWidgetRadius">12dp</item>
        <item name="appWidgetPadding">16dp</item>
        <item name="appWidgetInnerRadius">4dp</item>
    </style>

    <style name="AppTheme.AppWidgetContainer" parent="AppTheme.AppWidgetContainerParent" />

    <style name="AppTheme.AppWidgetContainer.IconOnly" parent="AppTheme.AppWidgetContainerParent">
        <item name="appWidgetPadding">8dp</item>
        <item name="appWidgetRadius">8dp</item>
    </style>

    <style name="Widget.AppTheme.AppWidgetOverlay" parent="android:Widget">
        <item name="android:id">@android:id/background</item>
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="android:padding">?attr/appWidgetPadding</item>
    </style>

    <style name="Widget.AppTheme.AppWidget" parent="Widget.AppTheme.AppWidgetOverlay" />

    <style name="Widget.AppTheme.BarChartView" parent="android:Widget">
        <!-- Bar appearance -->
        <item name="barColor">?attr/colorPrimaryContainer</item>
        <item name="selectedBarColor">?attr/colorPrimary</item>
        <item name="minBarWidth">8dp</item>
        <item name="maxBarWidth">24dp</item>
        <item name="valueOnTopOfBar">false</item>

        <!-- Grid appearance -->
        <item name="gridColor">?attr/colorOutline</item>
        <item name="gridStrokeWidth">1dp</item>
        <item name="gridLineCount">6</item>
        <item name="gridLabelsOnLeft">true</item>

        <!-- Label appearance -->
        <item name="textColor">?attr/colorOutline</item>
        <item name="textSize">@dimen/font_size_medium</item>
        <item name="yAxisFormat">@null</item>
        <item name="emptyText">@string/no_usage_in_this_time_range</item>

        <!-- Touch line appearance -->
        <item name="touchLineColor">?attr/colorOutline</item>
        <item name="touchLineWidth">2dp</item>

        <!-- Tooltip appearance -->
        <item name="tooltipBackgroundColor">?attr/colorSurfaceInverse</item>
        <item name="tooltipTextColor">?attr/colorOnSurfaceInverse</item>
        <item name="tooltipCornerRadius">6dp</item>
    </style>

    <style name="Widget.AppTheme.CardView.TrustCta" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>

    <style name="Widget.AppTheme.CardView.OnboardingMode" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/premium_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="rippleColor">?attr/colorSecondaryContainer</item>
    </style>

    <style name="Widget.AppTheme.Chip.MainFilter" parent="Widget.AppTheme.Chip.Filter">
        <item name="chipMinHeight">32dp</item>
        <item name="chipMinTouchTargetSize">@dimen/premium_chip_touch_target</item>
        <item name="chipCornerRadius">@dimen/premium_radius_control</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipStrokeColor">?attr/colorOutlineVariant</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
    </style>

    <style name="Widget.AppTheme.Chip.MainSuggestion" parent="Widget.AppTheme.Chip.Suggestion">
        <item name="chipMinHeight">32dp</item>
        <item name="chipMinTouchTargetSize">@dimen/premium_chip_touch_target</item>
        <item name="chipCornerRadius">@dimen/premium_radius_control</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipStrokeColor">?attr/colorOutlineVariant</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
    </style>

    <style name="Widget.AppTheme.Chip.DetailFact" parent="Widget.Material3.Chip.Assist">
        <item name="chipMinHeight">32dp</item>
        <item name="chipMinTouchTargetSize">@dimen/premium_chip_touch_target</item>
        <item name="chipCornerRadius">0dp</item>
        <item name="chipBackgroundColor">@android:color/transparent</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipIconSize">@dimen/premium_status_dot_size</item>
        <item name="android:textAppearance">@style/TextAppearance.AppTheme.V2.LabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.AppTheme.Button.AppInfoAction" parent="Widget.AppTheme.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/premium_button_min_height</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/premium_space_12</item>
        <item name="android:paddingEnd">@dimen/premium_space_12</item>
        <item name="android:textAppearance">@style/TextAppearance.AppTheme.V2.LabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/premium_space_8</item>
        <item name="iconSize">@dimen/premium_icon_20</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.AppTheme.TextInputLayout.ReadOnlyFlat" parent="Widget.Material3.TextInputLayout.FilledBox.Dense">
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="hintTextAppearance">@style/TextAppearance.AppTheme.V2.LabelSmall</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
